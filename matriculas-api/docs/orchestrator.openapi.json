{
  "openapi": "3.1.0",
  "info": {
    "title": "Orquestador de Matrículas",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/matriculas": {
      "post": {
        "summary": "Matricular",
        "operationId": "matricular_v1_matriculas_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Matricular"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SagaOut"
                }
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SagaOut"
                }
              }
            },
            "description": "Created"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SagaOut"
                }
              }
            },
            "description": "Accepted"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SagaOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sagas/{saga_id}": {
      "get": {
        "summary": "Consultar",
        "operationId": "consultar_v1_sagas__saga_id__get",
        "parameters": [
          {
            "name": "saga_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Saga Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SagaOut"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "SIN_CUPOS"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "El curso 5 no tiene cupos disponibles"
            ]
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Matricular": {
        "properties": {
          "alumno_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Alumno Id"
          },
          "curso_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Curso Id"
          },
          "monto": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Monto",
            "description": "Unidades monetarias enteras; sin datos de tarjeta"
          }
        },
        "type": "object",
        "required": [
          "alumno_id",
          "curso_id",
          "monto"
        ],
        "title": "Matricular"
      },
      "SagaOut": {
        "properties": {
          "alumno_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Alumno Id"
          },
          "curso_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Curso Id"
          },
          "monto": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Monto",
            "description": "Unidades monetarias enteras; sin datos de tarjeta"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "estado": {
            "type": "string",
            "pattern": "^(EN_CURSO|COMPLETADA|COMPENSANDO|COMPENSADA|COMPENSACION_PENDIENTE)$",
            "title": "Estado"
          },
          "motivo_fallo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo Fallo"
          }
        },
        "type": "object",
        "required": [
          "alumno_id",
          "curso_id",
          "monto",
          "id",
          "estado",
          "motivo_fallo"
        ],
        "title": "SagaOut"
      }
    }
  }
}
