# Plantilla de variables. NO contiene secretos: genera tu .env con
#
#     python scripts/generar_env.py
#
# (crea claves aleatorias; el .env esta en .gitignore y NO debe viajar en el ZIP ni en el repositorio).
# Prefijo MATRICULAS_ a proposito, para no chocar con variables de otros servicios del monorepo.
MATRICULAS_DB_NAME=matriculas_db
MATRICULAS_DB_USER=matriculas_user
# Obligatoria (sin valor por defecto): contrasena de PostgreSQL.
MATRICULAS_DB_PASSWORD=

# --- matriculas-api ---
# Claves de ADMINISTRADOR separadas por coma. OBLIGATORIA y SIN valor por defecto: la API no arranca
# si falta, es una clave publica conocida o tiene menos de 24 caracteres.
# Una real:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MATRICULAS_API_KEYS=
# Claves internas aleatorias; las genera scripts/generar_env.py.
ORCHESTRATOR_API_KEY=
INTERNAL_KEY=
# Secreto local de firma JWT. generar_env.py lo genera aleatoriamente.
MATRICULAS_JWT_SECRET=
# Duración de los tokens JWT, en minutos.
MATRICULAS_JWT_TTL_MINUTES=60

# Interfaz donde se publica la API (por defecto solo loopback; ver README, seccion TLS).
# API_BIND=127.0.0.1
# DOCS_ENABLED=true          # false en produccion: no publica /docs ni /openapi.json
# STUDENT_KEY_TTL_DAYS=90    # vigencia de las claves de estudiante (0 = no caducan)
# AUTH_FAIL_LIMIT=20         # intentos de autenticacion fallidos por IP y ventana
# AUTH_FAIL_WINDOW_SECONDS=60
# WRITE_RATE_LIMIT_PER_MINUTE=60   # matricular/revertir por minuto con clave de estudiante (0 = sin limite)
# CURSOS_CACHE_TTL_SECONDS=5

# Timeout por llamada gRPC hacia Cupos, en segundos.
CUPOS_GRPC_TIMEOUT_SECONDS=2.0
# Fallas consecutivas hacia Cupos antes de abrir el circuit breaker.
CUPOS_CB_FAILURE_THRESHOLD=5
# Segundos que el circuit breaker permanece abierto antes de reintentar.
CUPOS_CB_RECOVERY_SECONDS=15.0

# Matriculas PENDIENTES: el cliente puede reintentar con la misma Idempotency-Key durante TTL/2; pasado
# el TTL el conciliador la anula y libera el cupo. El conciliador corre cada N segundos (0 = apagado).
PENDING_TTL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=10

# --- API Gateway ---
# Único puerto publicado. Para acceso remoto, poner el gateway detrás de TLS.
API_BIND=127.0.0.1
GATEWAY_RATE_LIMIT=120
GATEWAY_RATE_WINDOW_SECONDS=60
GATEWAY_PROXY_TIMEOUT_SECONDS=30
JWT_ISSUER=matriculas-api-local
JWT_AUDIENCE=matriculas-api

# --- BFF web ---
BFF_UPSTREAM_TIMEOUT_SECONDS=4
BFF_MAX_WORKERS=16

# --- Pagos (Transbank Webpay Plus) ---
# Claves propias entre servicios; las genera scripts/generar_env.py (sin valor por defecto).
PAGOS_API_KEY=
PAGOS_CALLBACK_KEY=
# URL pública del gateway: Webpay devuelve aquí al comprador (/v1/pagos/retorno).
PAGOS_PUBLIC_BASE_URL=http://localhost:8000
# Transbank: por defecto el AMBIENTE DE INTEGRACIÓN gratuito con las credenciales públicas de pruebas
# (transbankdevelopers.cl). No cobra dinero real. Para producción: TBK_BASE_URL=https://webpay3g.transbank.cl
# con TBK_COMMERCE_CODE y TBK_API_KEY propios.
# TBK_BASE_URL=https://webpay3gint.transbank.cl
# TBK_COMMERCE_CODE=597055555532
# TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Tiempos: create/refund deben caber en SAGA_TIMEOUT_SECONDS (Webpay real tarda ~0,5–1,5 s: usa 3 y 2,5).
# TBK_TIMEOUT_SECONDS=1.5
# PAGOS_TTL_SECONDS=600          # plazo del comprador para pagar
# PAGOS_CB_THRESHOLD=5
# PAGOS_BULKHEAD=8

# --- Saga de matrícula ---
PAGOS_URL=http://pagos:8000
# Con Webpay el comprador paga en un formulario externo: la saga espera y consulta a Pagos cada N s.
SAGA_PAGO_POLL_SECONDS=15
SAGA_PAGO_GRACIA_SECONDS=60
SAGA_TIMEOUT_SECONDS=2
SAGA_BULKHEAD=8
SAGA_CB_THRESHOLD=5
SAGA_CB_RECOVERY_SECONDS=15
SAGA_RETRIES=3
SAGA_BACKOFF_SECONDS=0.1
SAGA_STALE_SECONDS=60
SAGA_RECONCILE_SECONDS=10

# Solo Inscripción y el orquestador. No compartir con gateway/BFF/Pagos/clientes.
INSCRIPCION_WRITER_KEY=
